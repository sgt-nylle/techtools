{
  "manifest_version": 3,
  "name": "TechTools — Naval IT Diagnostics",
  "short_name": "TechTools",
  "version": "0.5.0",
  "description": "Sysadmin toolbox in your browser: subnet calculator, JWT/SAML inspector, DNS, certs, mail headers, URL probe and more. Local-first, keyboard-driven.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "TechTools (Alt+Shift+T)",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "permissions": ["storage", "contextMenus", "sidePanel"],
  "host_permissions": ["https://techtools.subwrite.se/*"],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+T",
        "mac": "Alt+Shift+T"
      },
      "description": "Open TechTools"
    },
    "open-side-panel": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Open TechTools in the side panel"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "techtools@subwrite.se",
      "strict_min_version": "121.0"
    }
  }
}
