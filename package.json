{
  "name": "techtools",
  "private": true,
  "version": "0.5.4",
  "author": "Sgt.Moon <sysop@subwrite.se>",
  "homepage": "https://techtools.subwrite.se",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "node server/server.mjs",
    "build:ext": "vite build --config vite.extension.config.ts",
    "watch:ext": "vite build --config vite.extension.config.ts --watch",
    "typecheck:ext": "tsc -p extension/tsconfig.json",
    "pack:ext": "bash scripts/pack-extension.sh",
    "release": "npm run build && npm run pack:ext",
    "build:ext:firefox": "npm run build:ext && node scripts/make-firefox-manifest.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
